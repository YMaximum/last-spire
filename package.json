{
  "name": "last-spire",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-api.mjs",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "balance": "node --import tsx scripts/audit-v3.ts",
    "analyze:logs": "node --import tsx scripts/analyze-gameplay.ts",
    "balance:runeforged": "node --import tsx scripts/balance-v2.ts",
    "balance:legacy": "node --import tsx scripts/balance.ts",
    "check:public": "node scripts/check-public.mjs",
    "check:secrets": "sh scripts/check-secrets.sh",
    "check:dependencies": "npm audit --package-lock-only --audit-level=moderate",
    "account:dev": "node --import tsx server/main.ts",
    "account:backup": "node --import tsx server/backup-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.4",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "google-auth-library": "^11.3.1"
  }
}
